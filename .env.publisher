# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=viaduct.proxy.rlwy.net:18942
KAFKA_TOPIC_PREFIX=stock-ticks
KAFKA_PARTITIONS=32
KAFKA_LINGER_MS=5
KAFKA_BATCH_SIZE=16384
KAFKA_ACKS=1
KAFKA_MAX_IN_FLIGHT=100

# ── Replay ─────────────────────────────────────────────────────────────────────
# Set REPLAY_SINGLE_SESSION_DATE to run a single day; leave blank for horizon mode.
REPLAY_SINGLE_SESSION_DATE=20250403
REPLAY_HORIZON_START=2025-04-02T10:00:00Z
REPLAY_SCALE_POLICY=session_rebase

# ── Scheduler ──────────────────────────────────────────────────────────────────
SCHEDULER_THREAD_POOL_SIZE=8
SCHEDULER_DISPATCH_INTERVAL_MS=10
SCHEDULER_LAG_THRESHOLD_WARN_MS=1000
SCHEDULER_LAG_THRESHOLD_FAIL_MS=4000
