# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY stock-dashboard-ui/package.json ./
RUN npm install --ignore-scripts

COPY stock-dashboard-ui/ .
ARG VITE_REASONING_AGENT_URL
ENV VITE_REASONING_AGENT_URL=${VITE_REASONING_AGENT_URL}
RUN npm run build

# ── Stage 2: nginx ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

RUN rm -rf /etc/nginx/conf.d/default.conf /usr/share/nginx/html/*

COPY --from=build /app/dist .

COPY stock-dashboard-ui/nginx.conf.template /etc/nginx/templates/default.conf.template

# Entrypoint: substitute only PORT and BACKEND_URL, leaving nginx vars untouched
RUN printf '#!/bin/sh\nset -e\nexport PORT="${PORT:-3000}"\n[ -z "$BACKEND_URL" ] && echo "ERROR: BACKEND_URL is required" && exit 1\nenvsubst '"'"'${PORT} ${BACKEND_URL}'"'"' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf\nexec nginx -g '"'"'daemon off;'"'"'\n' > /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/docker-entrypoint.sh"]
