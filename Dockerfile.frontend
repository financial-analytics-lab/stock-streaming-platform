# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY stock-dashboard-ui/package.json ./
RUN npm install --ignore-scripts

COPY stock-dashboard-ui/ .

# Baked into the JS bundle at build time — set these as Railway build variables
ARG VITE_BACKEND_URL
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
ARG VITE_REASONING_AGENT_URL
ENV VITE_REASONING_AGENT_URL=${VITE_REASONING_AGENT_URL}

RUN npm run build

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

EXPOSE 3000

# Railway sets PORT at runtime; vite preview serves dist/ with SPA fallback
CMD ["sh", "-c", "npx vite preview --host --port ${PORT:-3000}"]
